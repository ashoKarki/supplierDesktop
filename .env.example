NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SITE_URL=http://localhost:3000
# Required for private document storage, supplier links, and reminder processing.
# Server-only; never prefix the service key with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# DOCUMENT_SCANNER=local-noop
# On Vercel, configure a random secret of at least 32 characters for supplier portal rate limiting.
# SUPPLIER_PORTAL_RATE_SECRET=replace-with-a-long-random-secret
# Supplier email delivery (server-only; use a verified sender).
# RESEND_API_KEY=replace-with-resend-api-key
# RESEND_FROM_EMAIL=verified-sender@example.com
# Required by the scheduled reminder worker. Use distinct random secrets of at least 32 characters.
# REMINDER_CRON_SECRET=replace-with-a-long-random-secret
# REMINDER_LINK_SECRET=replace-with-a-different-long-random-secret
